{
	"name": "@spencerbeggs/vitest-bats",
	"version": "0.0.0",
	"private": true,
	"description": "Test bash scripts with kcov coverage directly in Vitest",
	"keywords": ["vitest", "bats", "bash", "shell", "testing", "kcov", "coverage"],
	"homepage": "https://github.com/spencerbeggs/vitest-bats#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/vitest-bats/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/vitest-bats.git"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "turbo run build --log-order=grouped --output-logs=full --log-prefix=none",
		"ci:build": "CI=\"true\" turbo run build --log-order=grouped --log-prefix=none --output-logs=full --no-color",
		"ci:test": "turbo run build --log-prefix=none --output-logs=errors-only && CI=\"true\" vitest run --coverage",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2  --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"test": "turbo run build --log-prefix=none --output-logs=errors-only && vitest run",
		"test:coverage": "turbo run build --log-prefix=none --output-logs=errors-only && vitest run --coverage",
		"test:local": "pnpm run build && vitest run --coverage",
		"test:watch": "turbo run build --log-prefix=none --output-logs=errors-only && vitest --watch",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effected/plugin": "catalog:effected",
		"@okfit/plugin": "^0.5.30",
		"@savvy-web/silk": "^4.5.7",
		"@vitest-agent/plugin": "^6.0.1",
		"vitest-bats": "workspace:*"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.18.0",
			"onFail": "download"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.13.0",
				"onFail": "ignore"
			}
		]
	}
}
